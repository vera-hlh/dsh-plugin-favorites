{
  "name": "dsh-plugin-favorites",
  "version": "1.2.3",
  "description": "Bookmark replies, whole turns, selected text, and files in DeepSeek Harness sessions, tag them, and jump back to the exact spot.",
  "author": "vera-hlh <eva.laiwah@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vera-hlh/dsh-plugin-favorites"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "bookmarks",
    "favorites",
    "sessions"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
